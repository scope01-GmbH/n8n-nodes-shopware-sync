{
  "id": "shopwareUpdate02",
  "name": "Shopware · 02 Update existing products by id",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Updating needs only the id and the fields that change - no mandatory payload.\n// Replace these ids with real product ids from your shop (32-char hex, no dashes).\nreturn [\n  { json: { id: '00000000000000000000000000000000', name: 'Renamed from n8n', stock: 5 } },\n];"
      },
      "id": "rows",
      "name": "Ids to update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "entity": "product",
        "batchSize": 100,
        "options": {
          "indexingBehavior": "use-queue-indexing"
        },
        "action": "upsert",
        "payloadSource": "json",
        "payloadJson": "={\n  \"id\": \"{{ $json.id }}\",\n  \"name\": \"{{ $json.name }}\",\n  \"stock\": {{ $json.stock }}\n}"
      },
      "id": "sync",
      "name": "Update products",
      "type": "@scope01gmbh/n8n-nodes-shopware-sync.shopwareSync",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "shopwareSyncApi": {
          "id": "shopwareSyncDemo",
          "name": "Shopware Sync - demo shop"
        }
      }
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Ids to update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ids to update": {
      "main": [
        [
          {
            "node": "Update products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
